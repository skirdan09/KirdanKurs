<Window x:Class="AttendanceApp.StudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Студенты" Height="550" Width="800"
        WindowStartupLocation="CenterOwner" Background="#FAF6F7" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Справочник студентов" FontSize="22" FontWeight="SemiBold"
                   Foreground="#350A13" Margin="0,0,0,20"/>

        <DataGrid x:Name="GridStudents" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" BorderThickness="0"
                  Background="White" RowBackground="White"
                  AlternatingRowBackground="#F5E6EA"
                  HorizontalGridLinesBrush="#EBD0D8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBox x:Name="TxtName" Width="220" Padding="6" Margin="0,0,10,0" FontSize="14"/>
            <TextBox x:Name="TxtGroup" Width="110" Padding="6" Margin="0,0,10,0" FontSize="14"/>
            <Button Content="Добавить" Background="#800020" Foreground="White"
                    Padding="15,6" BorderThickness="0" Click="BtnAdd_Click" Margin="0,0,10,0"/>
            <Button Content="Удалить" Background="#F5E6EA" Foreground="#800020"
                    Padding="15,6" BorderThickness="0" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>