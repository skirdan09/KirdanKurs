<Window x:Class="AttendanceApp.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Группы" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" Background="#FAF6F7" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Группы" FontSize="24" FontWeight="Bold" Foreground="#6D2331" Margin="0,0,0,15"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <DataGrid x:Name="GroupsDataGrid" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название группы" Binding="{Binding Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>