<Window x:Class="AttendanceApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F7" FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid>
        <Border Background="White" CornerRadius="15" Margin="40" Padding="40">
            <Border.Effect>
                <DropShadowEffect Color="#40000000" BlurRadius="20" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Добро пожаловать" FontSize="28" FontWeight="Bold" Foreground="#6D2331" HorizontalAlignment="Center"/>
                <TextBlock Text="Войдите в систему учета" FontSize="14" Foreground="#888" HorizontalAlignment="Center" Margin="0,5,0,30"/>

                <TextBlock Text="Логин" Foreground="#555" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtLogin" Height="40" Padding="10,8" BorderBrush="#E5D5D8" FontSize="15" Margin="0,0,0,15"/>

                <TextBlock Text="Пароль" Foreground="#555" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" Height="40" Padding="10,8" BorderBrush="#E5D5D8" FontSize="15" Margin="0,0,0,15"/>

                <TextBlock Text="Выберите роль" Foreground="#555" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbRole" Height="40" FontSize="15" Margin="0,0,0,15" VerticalContentAlignment="Center" SelectionChanged="CmbRole_SelectionChanged">
                    <ComboBoxItem Content="Преподаватель" IsSelected="True"/>
                    <ComboBoxItem Content="Студент"/>
                </ComboBox>

                <StackPanel x:Name="GroupPanel" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Ваша группа" Foreground="#555" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbGroup" Height="40" FontSize="15" VerticalContentAlignment="Center" DisplayMemberPath="Name"/>
                </StackPanel>

                <Button Content="Войти / Зарегистрироваться" Height="45" 
                        Background="#6D2331" Foreground="White" 
                        BorderThickness="0" FontSize="16" FontWeight="SemiBold" 
                        Cursor="Hand" Click="Login_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>