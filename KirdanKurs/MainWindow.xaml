<Window x:Class="AttendanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учет посещаемости и успеваемости" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F7" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="15,10" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6D2331"/>
                                <Setter Property="Foreground" Value="#6D2331"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#6D2331">
            <StackPanel>
                <StackPanel Margin="20,24,20,32">
                    <TextBlock Text="УЧЁТ" Foreground="White" FontSize="14" FontWeight="Bold" Opacity="0.7"/>
                    <TextBlock Text="Посещаемость" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="и успеваемость" Foreground="White" FontSize="12" Opacity="0.7"/>
                </StackPanel>

                <Button Content="Главная" Background="#8A2F41" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0"/>
                <Button x:Name="BtnStudents" Content="Студенты" Click="BtnStudents_Click" Background="Transparent" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0" Cursor="Hand"/>
                <Button x:Name="BtnGroups" Content="Группы" Click="BtnGroups_Click" Background="Transparent" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0" Cursor="Hand"/>
                <Button x:Name="BtnDisciplines" Content="Дисциплины" Click="BtnDisciplines_Click" Background="Transparent" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0" Cursor="Hand"/>
                <Button Content="Посещаемость" Background="Transparent" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0" Cursor="Hand"/>
                <Button Content="Успеваемость" Background="Transparent" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0" Cursor="Hand"/>
                <Button x:Name="BtnReports" Content="Отчеты" Background="Transparent" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0" Cursor="Hand"/>
                <Button x:Name="BtnSettings" Content="Настройки" Background="Transparent" Foreground="White" BorderThickness="0" Height="45" Margin="10,0" HorizontalContentAlignment="Left" Padding="20,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="24,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Главный экран" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock x:Name="TxtDate" Text="Дата" FontSize="12" Foreground="#888" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Сохранить копию БД" Background="#8A2F41" Foreground="White" BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Выход" Background="#F3E6E8" Foreground="#6D2331" BorderThickness="0" Padding="15,8" Click="Exit_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="24">
                <StackPanel>
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock x:Name="TxtWelcome" Text="Добро пожаловать!" FontSize="20" FontWeight="SemiBold" Foreground="#6D2331"/>
                            <TextBlock Text="Здесь вы можете вести учет посещаемости и успеваемости студентов." Foreground="#666" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock x:Name="TxtStatsTitle" Text="Краткая статистика" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                            <UniformGrid Columns="4">
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtStat1Name" Text="Студентов" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtStat1Value" Text="0" FontSize="28" FontWeight="Bold" Foreground="#6D2331"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtStat2Name" Text="Групп" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtStat2Value" Text="0" FontSize="28" FontWeight="Bold" Foreground="#6D2331"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtStat3Name" Text="Дисциплин" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtStat3Value" Text="0" FontSize="28" FontWeight="Bold" Foreground="#6D2331"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtStat4Name" Text="Задолженностей" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtStat4Value" Text="0" FontSize="28" FontWeight="Bold" Foreground="#6D2331"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <Border x:Name="StudentChart" Background="White" CornerRadius="8" Padding="15" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Посещаемость за неделю (%)" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                                    <Grid Height="60" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#F3E6E8" Height="40" VerticalAlignment="Bottom" Margin="5,0" ToolTip="80%"/>
                                        <Rectangle Grid.Column="1" Fill="#E5D5D8" Height="55" VerticalAlignment="Bottom" Margin="5,0" ToolTip="95%"/>
                                        <Rectangle Grid.Column="2" Fill="#8A2F41" Height="60" VerticalAlignment="Bottom" Margin="5,0" ToolTip="100%"/>
                                        <Rectangle Grid.Column="3" Fill="#E5D5D8" Height="45" VerticalAlignment="Bottom" Margin="5,0" ToolTip="85%"/>
                                        <Rectangle Grid.Column="4" Fill="#8A2F41" Height="50" VerticalAlignment="Bottom" Margin="5,0" ToolTip="90%"/>
                                    </Grid>
                                    <UniformGrid Columns="5" Margin="0,5,0,0">
                                        <TextBlock Text="Пн" HorizontalAlignment="Center" FontSize="10" Foreground="#888"/>
                                        <TextBlock Text="Вт" HorizontalAlignment="Center" FontSize="10" Foreground="#888"/>
                                        <TextBlock Text="Ср" HorizontalAlignment="Center" FontSize="10" Foreground="#888"/>
                                        <TextBlock Text="Чт" HorizontalAlignment="Center" FontSize="10" Foreground="#888"/>
                                        <TextBlock Text="Пт" HorizontalAlignment="Center" FontSize="10" Foreground="#888"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="TeacherChart" Background="White" CornerRadius="8" Padding="15" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Загруженность пар" FontSize="14" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TxtTeacherName" Text="Преподаватель" FontSize="12" Foreground="#888" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Пн:" Width="35" Foreground="#6D2331" FontWeight="Bold"/>
                                        <TextBlock Text="4 пары" Foreground="#333"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Вт:" Width="35" Foreground="#6D2331" FontWeight="Bold"/>
                                        <TextBlock Text="2 пары" Foreground="#333"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Ср:" Width="35" Foreground="#6D2331" FontWeight="Bold"/>
                                        <TextBlock Text="5 пар" Foreground="#333"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Чт:" Width="35" Foreground="#6D2331" FontWeight="Bold"/>
                                        <TextBlock Text="3 пары" Foreground="#333"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Пт:" Width="35" Foreground="#6D2331" FontWeight="Bold"/>
                                        <TextBlock Text="4 пары" Foreground="#333"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="TeacherQuickActions">
                        <TextBlock Text="Быстрые действия" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <Button Content="Отметить посещаемость" Background="White" Foreground="#6D2331" BorderThickness="1" BorderBrush="#E5D5D8" Padding="15,15" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Выставить оценки" Background="White" Foreground="#6D2331" BorderThickness="1" BorderBrush="#E5D5D8" Padding="15,15" Margin="5,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Сформировать отчет" Background="White" Foreground="#6D2331" BorderThickness="1" BorderBrush="#E5D5D8" Padding="15,15" Margin="10,0,0,0" Cursor="Hand" FontWeight="SemiBold"/>
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel x:Name="StudentQuickActions" Visibility="Collapsed">
                        <TextBlock Text="Мои сервисы" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <Button Content="Мои оценки" Background="White" Foreground="#6D2331" BorderThickness="1" BorderBrush="#E5D5D8" Padding="15,15" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Мое расписание" Background="White" Foreground="#6D2331" BorderThickness="1" BorderBrush="#E5D5D8" Padding="15,15" Margin="5,0" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Content="Моя посещаемость" Background="White" Foreground="#6D2331" BorderThickness="1" BorderBrush="#E5D5D8" Padding="15,15" Margin="10,0,0,0" Cursor="Hand" FontWeight="SemiBold"/>
                        </UniformGrid>
                    </StackPanel>

                    <Grid x:Name="TeacherBottomPanel" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Успеваемость студентов" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                                <TabControl Background="Transparent" BorderThickness="0">
                                    <TabItem Header="Должники">
                                        <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" IsReadOnly="True" Margin="0,10,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Студент" Binding="{Binding FullName}" Width="*"/>
                                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="100"/>
                                                <DataGridTextColumn Header="Задолженность" Binding="{Binding Debt}" Width="150"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Отличники">
                                        <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" IsReadOnly="True" Margin="0,10,0,0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Студент" Binding="{Binding FullName}" Width="*"/>
                                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="100"/>
                                                <DataGridTextColumn Header="Средний балл" Binding="{Binding AvgGrade}" Width="100"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#6D2331" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Расписание на сегодня" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>
                                <Border Background="#8A2F41" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="14:30 - 16:00" Foreground="#E5D5D8" FontSize="12"/>
                                        <TextBlock Text="МДК.01.01 Разработка ПО" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="ЗПК-1 | Каб. 204" Foreground="#E5D5D8" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#8A2F41" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="16:10 - 17:40" Foreground="#E5D5D8" FontSize="12"/>
                                        <TextBlock Text="ОП.04 Базы данных" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="ЗПК-2 | Каб. 301" Foreground="#E5D5D8" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>